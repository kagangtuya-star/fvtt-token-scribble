{
  "name": "token-scribble",
  "version": "1.0.0",
  "private": true,
  "description": "TokenScribble (随绘棋子) — instant freehand drawing on Foundry VTT tokens.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning tools/build.mjs",
    "build:dev": "node --disable-warning=ExperimentalWarning tools/build.mjs --dev",
    "watch": "node --disable-warning=ExperimentalWarning tools/build.mjs --dev --watch",
    "package": "node --disable-warning=ExperimentalWarning tools/build.mjs && node tools/package.mjs",
    "harness": "node --disable-warning=ExperimentalWarning tools/build.mjs --dev --harness",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.test.ts\" \"tests/*.test.mjs\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"dev/**/*.{ts,html}\" \"styles/**/*.css\" \"lang/**/*.json\" module.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"dev/**/*.{ts,html}\" \"styles/**/*.css\" \"lang/**/*.json\" module.json",
    "lint:i18n": "node tools/check-i18n.mjs",
    "check": "npm run typecheck && npm run lint:i18n && npm test && npm run build && npm run validate",
    "validate": "node tools/validate-manifest.mjs"
  },
  "dependencies": {
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
