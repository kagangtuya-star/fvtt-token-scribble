{
  "id": "token-scribble",
  "title": "TokenScribble 随绘棋子",
  "description": "Instantly create transparent tokens and draw on any token with a pressure-sensitive freehand pen — right on the map. Drawings are stored as compact vector data and stay sharp as tokens move, rotate and scale.",
  "version": "1.0.0",
  "authors": [
    {
      "name": "TokenScribble contributors"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "maximum": "14"
  },
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/token-scribble.css"],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "cn",
      "name": "中文",
      "path": "lang/zh-CN.json"
    },
    {
      "lang": "zh-cn",
      "name": "简体中文",
      "path": "lang/zh-CN.json"
    }
  ],
  "socket": true,
  "license": "LICENSE",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "flags": {
    "dataFormat": 1
  }
}
